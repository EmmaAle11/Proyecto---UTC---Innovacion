# ==============================================================================
#  .gitignore — UTC Pick Sazón
#  Stack: Expo / React Native (frontend) · NestJS (backend) · Docker: PostgreSQL +
#  Keycloak (infra) · design-system (referencia).
#
#  REGLA DE ORO (rules §17): NUNCA commitear secretos ni artefactos de build.
#  En git solo viven los *.env.example (placeholders 'cambia_esto_local').
#  Los git commit/push los hace el usuario a mano (rules §23).
# ==============================================================================

# --- Dependencias ---
node_modules/
.npm
.pnp.*
.yarn-integrity

# --- Builds / artefactos (se regeneran; un bundle puede embeber secretos) ---
dist/
build/
backend/dist/
web-build/
*.tgz

# --- Expo / React Native (frontend) ---
.expo/
.expo-shared/
.metro-health-check*
# Firmas / certificados de app móvil (nunca al repo)
*.jks
*.p8
*.p12
*.keystore
*.mobileprovision
*.orig.*
# Carpetas nativas: solo aparecen tras `expo prebuild` (managed no las versiona)
/frontend/ios/
/frontend/android/

# --- Entorno / SECRETOS (rules §17 — la regla de oro) ---
# Reales (con valores): infra/.env, backend/.env. Se versionan SOLO los .example.
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
*.env
!*.env.example
!**/.env.example
# Llaves, certificados y secretos sueltos
secrets/
*.pem
*.key
*.secret.json
*.secret.local
# Documento de respaldo de credenciales por ruta (NO commitear — texto plano)
SECRETOS.txt
**/SECRETOS.txt

# --- Docker / datos locales (PostgreSQL + Keycloak) ---
# El volumen 'pgdata' es named (no cae en el árbol); esto es defensivo por si
# alguien monta un bind-mount o genera dumps dentro del repo.
**/pgdata/
infra/**/data/
*.dump
*.sql.gz

# --- Logs y procesos ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# --- Tests / cobertura / caché de tooling ---
coverage/
.nyc_output
lib-cov
.eslintcache
.node_repl_history

# --- Sistema operativo / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
