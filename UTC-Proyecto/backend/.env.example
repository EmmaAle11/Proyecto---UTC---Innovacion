PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=utc
DB_PASSWORD=cambia_esto_local
DB_NAME=utc_food
KEYCLOAK_REALM=utc-food
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=mobile-app
# Opcional (defensa OIDC): si se define, el JWT debe traer este `aud`. Vacío/ausente = no se valida (comportamiento por defecto). Activar solo si el client de Keycloak emite este audience (verificar con un token real antes).
KEYCLOAK_AUDIENCE=
# Client service-account para crear usuarios vía Admin API (D-014). Mismo valor que infra/.env BACKEND_CLIENT_SECRET.
KEYCLOAK_BACKEND_CLIENT_ID=backend-svc
KEYCLOAK_BACKEND_CLIENT_SECRET=cambia_esto_local
# CORS: orígenes permitidos separados por coma (vacío = refleja cualquiera, solo dev). Restringir en prod.
CORS_ORIGIN=
