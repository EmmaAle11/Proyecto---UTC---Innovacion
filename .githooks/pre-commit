#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────
# Pre-commit hook — UTC Pick Sazón
# Regla de oro (rules §17): NUNCA commitear secretos ni artefactos de build.
#
# Bloquea el commit si en lo STAGEADO detecta:
#   1. Archivos .env reales (cualquier .env*, excepto *.env.example).
#   2. Artefactos de build (dist/ · backend/dist/ · web-build/).
#   3. Patrones de secreto en líneas agregadas: AKIA (AWS), AIza (Google),
#      JWT (eyJ...), "secret":"..." (JSON), y los secretos propios del
#      proyecto (Keycloak/Postgres) cuando llevan un valor real.
#
# Instalación (una vez por equipo/clon):  git config core.hooksPath .githooks
# Bypass de emergencia (con razón documentada):  git commit --no-verify
# ─────────────────────────────────────────────────────────────

fail=0

# 1) .env reales (excepto *.env.example)
STAGED_ENV=$(git diff --cached --name-only | grep -E "(^|/)\.env" | grep -vE "\.env\.example$" || true)
if [ -n "$STAGED_ENV" ]; then
  echo "[BLOQUEADO] archivo .env stageado (secretos NO se commitean):"
  echo "$STAGED_ENV" | sed 's/^/    /'
  echo "    Fix: git restore --staged <archivo>"
  fail=1
fi

# 2) Artefactos de build
STAGED_BUILD=$(git diff --cached --name-only | grep -E "(^|/)(dist|backend/dist|web-build)/" || true)
if [ -n "$STAGED_BUILD" ]; then
  echo "[BLOQUEADO] artefacto de build stageado (dist/ · backend/dist/ · web-build/):"
  echo "$STAGED_BUILD" | sed 's/^/    /'
  echo "    Fix: git restore --staged <ruta>"
  fail=1
fi

# 3) Patrones de secreto en líneas AGREGADAS del staged diff
ADDED=$(git diff --cached -U0 --no-color | grep -E "^\+" | grep -vE "^\+\+\+ " || true)

scan() { # $1 = regex, $2 = etiqueta
  if printf '%s\n' "$ADDED" | grep -qE "$1"; then
    echo "[BLOQUEADO] posible $2 en el staged diff:"
    printf '%s\n' "$ADDED" | grep -oE "$1" | head -3 | sed 's/^/    /'
    fail=1
  fi
}

scan "AKIA[0-9A-Z]{16}" "AWS Access Key"
scan "AIza[0-9A-Za-z_-]{35}" "Google API key"
scan "eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}" "JWT token"

# 3b) "secret": "valor" en JSON (p. ej. realm de Keycloak) con valor >= 8 chars
SECRET_JSON=$(printf '%s\n' "$ADDED" | grep -oE '"secret"[[:space:]]*:[[:space:]]*"[^"]{8,}"' || true)
if [ -n "$SECRET_JSON" ]; then
  echo "[BLOQUEADO] campo JSON \"secret\" con valor en el staged diff (¿realm/credenciales?):"
  echo "$SECRET_JSON" | sed -E 's/:.*/: "<oculto>"/' | head -3 | sed 's/^/    /'
  fail=1
fi

# 3c) Secretos propios del proyecto con VALOR REAL (no el placeholder)
SECRET_KEYS="POSTGRES_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|ADMIN_SEED_PASSWORD|BACKEND_CLIENT_SECRET|DB_PASSWORD|KEYCLOAK_BACKEND_CLIENT_SECRET"
OWN=$(printf '%s\n' "$ADDED" | grep -E "(${SECRET_KEYS})[[:space:]]*=" | grep -vE "=[[:space:]]*(cambia_esto_local)?[[:space:]]*$" || true)
if [ -n "$OWN" ]; then
  echo "[BLOQUEADO] secreto del proyecto con valor real en el staged diff:"
  printf '%s\n' "$OWN" | sed -E 's/=.*/=<oculto>/' | head -5 | sed 's/^/    /'
  echo "    Usa *.env.example con el placeholder 'cambia_esto_local'."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit BLOQUEADO. Corrige lo anterior o, en emergencia documentada: git commit --no-verify"
  exit 1
fi

echo "[OK] pre-commit: sin secretos ni artefactos en el staged diff."
exit 0
