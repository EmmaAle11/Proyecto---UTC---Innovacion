{
  "expo": {
    "name": "UTC Pick Sazón",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "mx.utc.picksazon",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UTC Pick Sazón usa tu ubicación para mostrarte la cooperativa más cercana."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "de4cc335-b423-4391-bab2-aff55efaabd8"
      }
    },
    "owner": "mrem1011"
  }
}
