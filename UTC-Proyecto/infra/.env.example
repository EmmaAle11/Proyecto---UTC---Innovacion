# Copiar a infra/.env y poner valores locales. infra/.env NO se commitea (rules §16/§17).
POSTGRES_USER=utc
POSTGRES_PASSWORD=cambia_esto_local
POSTGRES_DB=utc_food
# === Admin del SERVIDOR Keycloak (consola /admin/, realm master) ===
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=cambia_esto_local
# Puertos de host (defaults documentados). Cámbialos si ya están ocupados en tu equipo.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
# === Admin de la APP (realm utc-food, rol admin, Account Console/panel; sin Microsoft). Ver D-013. ===
ADMIN_SEED_USERNAME=coop-admin
ADMIN_SEED_EMAIL=admin@tu-dominio.example
ADMIN_SEED_PASSWORD=cambia_esto_local
# Opcional (Keycloak exige firstName/lastName); el script usa estos defaults si faltan:
# ADMIN_SEED_FIRSTNAME=Administrador
# ADMIN_SEED_LASTNAME=Cooperativa UTC
# Secreto del client service-account 'backend-svc' (el backend lo usa para crear usuarios). Ver D-014.
BACKEND_CLIENT_SECRET=cambia_esto_local
