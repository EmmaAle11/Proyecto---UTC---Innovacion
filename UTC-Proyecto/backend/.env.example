PORT=3002
NODE_ENV=development
# TRUST_PROXY=1  # nº de saltos si corre detrás de proxy/túnel (cloudflared); vacío = sin proxy

# HTTPS (prod only; dev usa HTTP por defecto).
# Generar: openssl req -x509 -newkey rsa:4096 -nodes -out cert.pem -keyout key.pem -days 365 -subj "/CN=localhost"
HTTPS_ENABLED=false
HTTPS_CERT_PATH=./cert.pem
HTTPS_KEY_PATH=./key.pem

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=utc
DB_PASSWORD=cambia_esto_local
DB_NAME=utc_food

# Keycloak (auth)
KEYCLOAK_REALM=utc-food
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=mobile-app
# Opcional: validación de audience (OPT-IN OIDC, vacío = no valida)
KEYCLOAK_AUDIENCE=
# Service account para Admin API (D-014)
KEYCLOAK_BACKEND_CLIENT_ID=backend-svc
KEYCLOAK_BACKEND_CLIENT_SECRET=cambia_esto_local

# CORS (dev = refleja cualquiera; prod = lista por comas)
CORS_ORIGIN=
